<resources>

    <!-- The window theme: what shows before Compose draws, on launch and between screens.
         Everything inside the window is themed by GuilelessTheme (ui/theme/GuilelessTheme.kt),
         which reads the same palette; the platform's own Material theme is parent enough. -->
    <style name="AppBaseTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorGuilelessBopomofoMorandiThemeBase6</item>
        <item name="android:colorAccent">@color/colorGuilelessBopomofoMorandiThemeBase6</item>
        <item name="android:colorBackground">@color/colorGuilelessBopomofoMorandiSurface</item>
        <item name="android:windowBackground">@color/colorGuilelessBopomofoMorandiSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- generic (light) theme. -->
    <style name="AppTheme" parent="AppBaseTheme" />
</resources>
